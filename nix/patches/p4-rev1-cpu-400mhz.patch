Lets ESP32-P4 below rev 3.0 run the CPU at 400 MHz from a 400 MHz CPLL (MEM
200, APB 100). v6.1 offers ESP_DEFAULT_CPU_FREQ_MHZ_400 on those revisions, but
rtc_clk.c only accepts 360/180/90 there, so selecting it aborts in
esp_clk_init() and rtc_clk_cpu_freq_set_config() cannot reach it at run time.
Not upstream; Espressif does not guarantee 400 MHz below rev 3.0.

diff --git a/components/esp_hw_support/port/esp32p4/rtc_clk.c b/components/esp_hw_support/port/esp32p4/rtc_clk.c
--- a/components/esp_hw_support/port/esp32p4/rtc_clk.c
+++ b/components/esp_hw_support/port/esp32p4/rtc_clk.c
@@ -239,6 +239,7 @@
     uint32_t apb_divider = 1;
 #if CONFIG_ESP32P4_SELECTS_REV_LESS_V3
     switch (cpu_freq_mhz) {
+    case 400:
     case 360:
         mem_divider = 2;
         apb_divider = 2;
@@ -349,6 +350,11 @@
         real_freq_mhz = freq_mhz;
         source = SOC_CPU_CLK_SRC_CPLL;
         source_freq_mhz = CLK_LL_PLL_360M_FREQ_MHZ;
+        divider.integer = 1;
+    } else if (freq_mhz == 400) {
+        real_freq_mhz = freq_mhz;
+        source = SOC_CPU_CLK_SRC_CPLL;
+        source_freq_mhz = CLK_LL_PLL_400M_FREQ_MHZ;
         divider.integer = 1;
     } else {
         // unsupported frequency
