Fixes a lost PPA transaction when clients on two cores queue work. The done ISR
looked at the engine queue, found it empty and gave the engine semaphore some
microseconds later. A task queueing in between failed to take the semaphore and
relied on the ISR to start its transaction, which the ISR had already decided
not to do. The transaction then sat in the queue until the next one finished,
for good if none followed. Not upstream.

--- a/components/esp_driver_ppa/src/ppa_core.c
+++ b/components/esp_driver_ppa/src/ppa_core.c
@@ -561,6 +561,13 @@
     // Remove this transaction from transaction queue
     STAILQ_REMOVE(&engine_base->trans_stailq, trans_elm, ppa_trans_s, entry);
     next_start_trans = STAILQ_FIRST(&engine_base->trans_stailq);
+    // Together with the check above: a task on the other core queues and then
+    // takes this semaphore, so with a gap in between it would find the engine
+    // busy after this ISR found the queue empty, and nothing would start it.
+    if (!next_start_trans) {
+        xSemaphoreGiveFromISR(engine_base->sem, &HPTaskAwoken);
+        need_yield |= (HPTaskAwoken == pdTRUE);
+    }
     portEXIT_CRITICAL_ISR(&engine_base->spinlock);
 
     portENTER_CRITICAL_ISR(&client->spinlock);
@@ -578,8 +585,6 @@
     if (next_start_trans) {
         ppa_dma2d_enqueue(next_start_trans);
     } else {
-        xSemaphoreGiveFromISR(engine_base->sem, &HPTaskAwoken);
-        need_yield |= (HPTaskAwoken == pdTRUE);
 #if CONFIG_PM_ENABLE
         esp_err_t pm_lock_ret = esp_pm_lock_release(engine_base->pm_lock);
         assert(pm_lock_ret == ESP_OK);
