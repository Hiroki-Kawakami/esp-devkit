menu "devkit_crypto"

config DEVKIT_CRYPTO_MBEDTLS
    bool
    default y
    select MBEDTLS_AES_C
    select MBEDTLS_GCM_C
    select MBEDTLS_CHACHA20_C
    select MBEDTLS_CHACHAPOLY_C
    select MBEDTLS_ECP_C
    select MBEDTLS_ECP_DP_SECP256R1_ENABLED
    select MBEDTLS_ECP_DP_SECP384R1_ENABLED
    select MBEDTLS_ECP_DP_SECP521R1_ENABLED
    select MBEDTLS_ECP_DP_CURVE25519_ENABLED
    select MBEDTLS_ECDH_C
    select MBEDTLS_ECDSA_C
    select MBEDTLS_RSA_C
    select MBEDTLS_PKCS1_V15
    select MBEDTLS_PKCS1_V21
    select MBEDTLS_SHA1_C
    select MBEDTLS_SHA256_C
    select MBEDTLS_SHA384_C
    select MBEDTLS_SHA512_C
    select MBEDTLS_THREADING_C

choice DEVKIT_CRYPTO_CA_BUNDLE
    prompt "Default CA bundle"
    default DEVKIT_CRYPTO_CA_BUNDLE_NONE
    help
        Mozilla's roots, as the dev shell's DEVKIT_CA_BUNDLE holds them, for
        x509::TrustStore::default_bundle().

config DEVKIT_CRYPTO_CA_BUNDLE_NONE
    bool "None"

config DEVKIT_CRYPTO_CA_BUNDLE_EMBEDDED
    bool "Embedded in the app"
    help
        Changes only with the firmware; ca_bundle::install is unsupported.

config DEVKIT_CRYPTO_CA_BUNDLE_PARTITION
    bool "In a data partition"
    help
        Written by `idf.py flash` and replaceable at run time with
        ca_bundle::install. The partition holds two copies of the bundle
        plus 8 KiB; 192 KiB leaves room to grow.

endchoice

config DEVKIT_CRYPTO_CA_PARTITION
    string "CA bundle partition label"
    depends on DEVKIT_CRYPTO_CA_BUNDLE_PARTITION
    default "ca_bundle"

endmenu
