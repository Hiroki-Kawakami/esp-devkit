menu "USB device"

config USBD
    bool "USB device stack"
    depends on DEVKIT_SIMULATOR || SOC_USB_OTG_SUPPORTED
    default n
    help
        Device stack for the DWC2 controller, with functions composed into one
        configuration. On the simulator the controller is a USB/IP server.

config USBD_VENDOR
    bool "Vendor-specific function"
    depends on USBD
    default n
    help
        One vendor-specific interface with bulk endpoints.

config USBD_UAC
    bool "USB Audio Class 2.0 speaker"
    depends on USBD
    default n
    help
        An isochronous audio stream from the host, with mute and volume.

config USBD_HID
    bool "HID function"
    depends on USBD
    default n
    help
        One HID interface with an interrupt IN endpoint, as a boot keyboard,
        a boot mouse or with a report descriptor of the caller's.

endmenu
