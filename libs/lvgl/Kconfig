# LVGL options for the esp-devkit build of LVGL (see CMakeLists.txt for the
# pinned version). Symbol names follow upstream's Kconfig, which lv_conf_internal.h
# reads; an upstream bool missing here is compiled as 0.

menu "LVGL"

config LV_CONF_SKIP
    bool
    default y

config LV_STDLIB_BUILTIN
    int
    default 0

config LV_USE_STDLIB_STRING
    int
    default 1

config LV_USE_STDLIB_SPRINTF
    int
    default 1

config LV_USE_OS
    int
    default 1 if DEVKIT_SIMULATOR
    default 2

config LV_USE_FREERTOS_TASK_NOTIFY
    bool
    default y if !DEVKIT_SIMULATOR

config LV_USE_DRAW_SW
    bool
    default y

choice LV_MALLOC
    prompt "LVGL heap"
    default LV_MALLOC_CLIB

    config LV_MALLOC_CLIB
        bool "C library malloc"

    config LV_MALLOC_SPIRAM
        bool "SPIRAM"
        depends on SPIRAM
endchoice

config LV_USE_STDLIB_MALLOC
    int
    default 255 if LV_MALLOC_SPIRAM
    default 1

menu "Rendering Configuration"

choice LV_COLOR_FORMAT_DEFAULT
    prompt "Default color format"
    default LV_COLOR_FORMAT_RGB565

    config LV_COLOR_FORMAT_I1
        bool "I1"
    config LV_COLOR_FORMAT_L8
        bool "L8"
    config LV_COLOR_FORMAT_RGB565
        bool "RGB565"
    config LV_COLOR_FORMAT_RGB565_SWAPPED
        bool "RGB565 (Big-endian)"
    config LV_COLOR_FORMAT_RGB888
        bool "RGB888"
    config LV_COLOR_FORMAT_XRGB8888
        bool "XRGB8888"
    config LV_COLOR_FORMAT_ARGB8888
        bool "ARGB8888"
    config LV_COLOR_FORMAT_ARGB8888_PREMULTIPLIED
        bool "ARGB8888 (premultiplied)"
endchoice

config LV_COLOR_DEPTH
    int
    default 1 if LV_COLOR_FORMAT_I1
    default 8 if LV_COLOR_FORMAT_L8
    default 16 if LV_COLOR_FORMAT_RGB565 || LV_COLOR_FORMAT_RGB565_SWAPPED
    default 24 if LV_COLOR_FORMAT_RGB888
    default 32

config LV_COLOR_MIX_ROUND_OFS
    int "Color mix rounding offset"
    default 0
    range 0 254

config LV_DEF_REFR_PERIOD
    int "Default refresh period (ms)"
    default 33

config LV_DPI_DEF
    int "Default DPI (px/inch)"
    default 130

config LV_DRAW_BUF_STRIDE_ALIGN
    int "Draw buffer stride alignment (bytes)"
    default 1

config LV_DRAW_BUF_ALIGN
    int "Draw buffer address alignment (bytes)"
    default 4

config LV_USE_MATRIX
    bool "Matrix"
    select LV_USE_FLOAT

config LV_DRAW_TRANSFORM_USE_MATRIX
    bool "Matrix based transformations"
    depends on LV_USE_MATRIX

config LV_DRAW_LAYER_SIMPLE_BUF_SIZE
    int "Simple layer buffer size (bytes)"
    default 24576

config LV_DRAW_LAYER_MAX_MEMORY
    int "Maximum layer memory (bytes, 0 = no limit)"
    default 0

config LV_DRAW_THREAD_STACK_SIZE
    int "Draw thread stack size (bytes)"
    default 32768 if DEVKIT_SIMULATOR
    default 8192

config LV_DRAW_THREAD_PRIO
    int "Draw thread priority"
    range 0 4
    default 3

config LV_USE_SNAPSHOT
    bool "Snapshot"

