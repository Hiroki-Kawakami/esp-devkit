# Board selection for the shared bsp component. ESP-IDF limits the choice to
# boards supported by CONFIG_IDF_TARGET; the simulator can select any board.

menu "Board Support Package"

choice BSP_BOARD
    prompt "Target board"
    default BSP_BOARD_CORE      if DEVKIT_SIMULATOR
    default BSP_BOARD_CORE      if IDF_TARGET_ESP32
    default BSP_BOARD_CORE_S3   if IDF_TARGET_ESP32S3
    default BSP_BOARD_TAB5      if IDF_TARGET_ESP32P4
    default BSP_BOARD_S31_KORVO if IDF_TARGET_ESP32S31

    config BSP_BOARD_CORE
        bool "M5Stack Core (Basic / Core2)"
        depends on DEVKIT_SIMULATOR || IDF_TARGET_ESP32

    config BSP_BOARD_PAPER
        bool "M5Paper (ESP32)"
        depends on DEVKIT_SIMULATOR || IDF_TARGET_ESP32

    config BSP_BOARD_ATOM_LITE
        bool "M5Stack ATOM Lite (ESP32)"
        depends on DEVKIT_SIMULATOR || IDF_TARGET_ESP32

    config BSP_BOARD_STICKC_PLUS
        bool "M5StickC-Plus (ESP32)"
        depends on DEVKIT_SIMULATOR || IDF_TARGET_ESP32

    config BSP_BOARD_CORE_S3
        bool "M5Stack CoreS3 (ESP32-S3)"
        depends on DEVKIT_SIMULATOR || IDF_TARGET_ESP32S3

    config BSP_BOARD_PAPER_S3
        bool "M5PaperS3 (ESP32-S3)"
        depends on DEVKIT_SIMULATOR || IDF_TARGET_ESP32S3

    config BSP_BOARD_LILYGO_T5
        bool "LilyGo T5 ePaper S3 (ESP32-S3)"
        depends on IDF_TARGET_ESP32S3

    config BSP_BOARD_ATOM_S3_LITE
        bool "M5Stack AtomS3 Lite (ESP32-S3)"
        depends on DEVKIT_SIMULATOR || IDF_TARGET_ESP32S3

    config BSP_BOARD_AIRQ
        bool "M5Stack Air Quality Kit (ESP32-S3)"
        depends on DEVKIT_SIMULATOR || IDF_TARGET_ESP32S3

    config BSP_BOARD_TAB5
        bool "M5Stack Tab5 (ESP32-P4)"
        depends on DEVKIT_SIMULATOR || IDF_TARGET_ESP32P4

    config BSP_BOARD_S31_KORVO
        bool "ESP32-S31-Korvo"
        depends on DEVKIT_SIMULATOR || IDF_TARGET_ESP32S31
endchoice

config BSP_M5_HDMI_FPGA_BITSTREAM
    bool "Bundle the HDMI module's FPGA bitstream"
    depends on BSP_BOARD_TAB5 && !DEVKIT_SIMULATOR
    default y
    help
        Link the video module's FPGA gateware into the firmware (~222 KB) so a
        module whose FPGA SRAM is empty -- every cold start -- is loaded over
        JTAG during attach. Turn this off to reclaim the flash, at the cost of
        only working with a module some other host has already loaded.

config BSP_EPD_LL_TWEAK
    bool "epd_ll waveform-tuning backdoor"
    depends on (BSP_BOARD_PAPER_S3 || BSP_BOARD_LILYGO_T5) && !DEVKIT_SIMULATOR
    default n
    help
        Compile the epd_ll waveform-tuning backdoor (epd_ll_tweak.h): swap a
        live panel's waveform LUT over the serial console without a reflash.
        For the epd_tweak development firmware only -- leave off in production.

endmenu
